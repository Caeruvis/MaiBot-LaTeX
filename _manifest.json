  "author": {"name": "Caeruvis", "url": "https://github.com/Caeruvis"},
  "license": "MIT",
  "urls": {"repository": "https://github.com/Caeruvis/MaiBot-LaTeX"},
  "host_application": {"min_version": "1.3.19", "max_version": "1.3.19"},
  "sdk": {"min_version": "2.21.0", "max_version": "2.21.0"},
  "plugin_type": "extension",
  "capabilities": ["send.hybrid", "send.text"],
  "dependencies": [],
  "i18n": {"default_locale": "zh-CN"}
}
