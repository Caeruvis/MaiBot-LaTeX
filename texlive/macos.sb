(version 1)
(deny default)
(allow process-exec (literal (param "EXECUTABLE")))
(allow sysctl-read)
(allow file-read-metadata)
(allow file-read* file-map-executable
    (literal "/")
    (literal (param "EXECUTABLE"))
    (subpath (param "WORK"))
    (subpath (param "TEXROOT"))
    (subpath "/System/Library")
    (subpath "/System/Volumes/Preboot/Cryptexes/OS")
    (subpath "/private/preboot/Cryptexes/OS")
    (subpath "/usr/lib")
    (subpath "/usr/share")
    (subpath "/Library/Fonts")
    (subpath "/opt/homebrew/Cellar")
    (subpath "/opt/homebrew/etc/fonts")
    (subpath "/usr/local/Cellar")
    (subpath "/usr/local/etc/fonts")
    (subpath "/private/etc/fonts")
    (literal "/dev/null")
    (literal "/dev/urandom")
    (literal "/dev/random"))
(allow file-write* (subpath (param "WORK")) (literal "/dev/null"))
